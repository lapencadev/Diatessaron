// El primero de la lista es el que aparece destacado al cargar la página.
const videos = [
  {
    id: 'r-h7S0uo7VY',
    titulo: 'Concierto Western — Resumen',
    descripcion: 'Resumen del espectacular concierto temático dedicado a la música del Lejano Oeste (2025).',
  },
  {
    id: 'x3VA9Q5O_cU',
    titulo: 'Rheinberger: Kyrie a doble coro',
    descripcion: 'Del programa «Destellos», en la iglesia de San Vicente Mártir de Molina de Segura (octubre de 2023).',
  },
  {
    id: 'QJhQZnbSBYs',
    titulo: 'Arnesen: Even When He Is Silent',
    descripcion: 'La delicada obra de Kim André Arnesen. Programa «Destellos», Auditorio Víctor Villegas (junio de 2023).',
  },
  {
    id: 'qLhwVskpd5s',
    titulo: 'Thomàs: Bressol trist',
    descripcion: 'La nana del compositor mallorquín Joan Maria Thomàs. Programa «Destellos», Auditorio Víctor Villegas (junio de 2023).',
  },
  {
    id: 'r8ID90y7Mgk',
    titulo: 'Ola Gjeilo: Northern Lights',
    descripcion: 'Del programa «Destellos».',
  },
  {
    id: 'oUk75LDOK30',
    titulo: 'Josep Vila: Sanctus-Benedictus',
    descripcion: 'Del programa «Destellos».',
  },
  {
    id: '-0Ypi9jN4JA',
    titulo: 'Brahms: Geistliches Lied',
    descripcion: 'Del programa «Fons amoris», en la iglesia de la Virgen del Carmen de Murcia (junio de 2021).',
  },
  {
    id: '40RVgRjTEH0',
    titulo: 'Así suena Diatessaron',
    descripcion: 'Un recorrido en imágenes y música por los primeros años del coro.',
  },
  {
    id: 'kRhEwfEos80',
    titulo: 'Signore delle cime — con el Coro Joven de Murcia',
    descripcion: 'Junto al Coro Joven de Murcia, en el intercambio celebrado en Molina de Segura (noviembre de 2019).',
  },
  {
    id: '4oqtOnAhxTE',
    titulo: 'De la luz a la penumbra — MUDEM',
    descripcion: 'Concierto de la Semana Musical de Santa Cecilia en el Auditorio MUDEM de Molina de Segura (2019).',
  },
  {
