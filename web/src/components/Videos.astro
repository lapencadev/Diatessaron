const primero = videos[0];
---

<section id="videos" class="py-16 px-4 bg-coro-dark">
  <div class="max-w-5xl mx-auto">

    <div class="reveal">
      <h2 class="section-title">Vídeos</h2>
      <div class="section-divider"></div>
    </div>

    <!-- Reproductor destacado -->
    <div class="reveal reveal-delay-1">
      <div
        id="video-stage"
        class="relative w-full max-w-3xl mx-auto rounded-sm overflow-hidden border border-coro-gold/15 bg-black"
        style="aspect-ratio: 16 / 9;"
      >
        <button
          id="video-play"
          class="group absolute inset-0 w-full h-full cursor-pointer"
          data-id={primero.id}
          data-titulo={primero.titulo}
          aria-label={`Reproducir: ${primero.titulo}`}
        >
          <img
            src={`https://i.ytimg.com/vi/${primero.id}/hqdefault.jpg`}
            alt=""
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <span class="absolute inset-0 bg-coro-dark/30 group-hover:bg-coro-dark/10 transition-colors duration-300" aria-hidden="true"></span>
          <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-16 h-16 rounded-full bg-coro-dark/70 border border-coro-gold/60 flex items-center justify-center group-hover:scale-105 transition-transform duration-300" aria-hidden="true">
            <svg class="w-6 h-6 text-coro-gold ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </span>
        </button>
        <noscript>
          <p class="absolute bottom-3 left-0 right-0 text-center text-xs text-coro-light/80 px-4">
            Para ver los vídeos, visita nuestro <a class="text-coro-gold underline" href="https://www.youtube.com/@corodiatessaron">canal de YouTube</a>.
          </p>
        </noscript>
      </div>

      <div class="max-w-3xl mx-auto mt-4 min-h-[3.5rem]">
        <h3 id="video-titulo" class="text-coro-light font-serif text-xl">{primero.titulo}</h3>
        <p id="video-desc" class="text-coro-light/50 text-sm mt-1">{primero.descripcion}</p>
      </div>
    </div>

    <!-- Tira de miniaturas -->
    <div class="mt-8 -mx-4 px-4 overflow-x-auto pb-3 reveal reveal-delay-2">
      <div class="flex gap-3" style="scroll-snap-type: x proximity;">
        {videos.map((v, i) => (
          <button
            class={`video-thumb flex-shrink-0 w-40 text-left ${i === 0 ? 'is-active' : ''}`}
            style="scroll-snap-align: start;"
            data-id={v.id}
            data-titulo={v.titulo}
            data-descripcion={v.descripcion}
            aria-label={`Ver: ${v.titulo}`}
          >
            <div class="thumb-frame relative rounded-sm overflow-hidden" style="aspect-ratio: 16 / 9;">
              <img
                src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
                alt=""
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <p class="thumb-title text-xs mt-1.5 leading-snug text-coro-light/60 transition-colors duration-300">{v.titulo}</p>
          </button>
        ))}
      </div>
    </div>

    <!-- Enlace al canal -->
    <div class="mt-10 text-center">
      <a
        href="https://www.youtube.com/@corodiatessaron"
        target="_blank"
        rel="noopener"
        class="btn-outline"
      >
        Ver canal de YouTube →
      </a>
    </div>

  </div>
</section>

<style>
  .thumb-frame {
    border: 1px solid rgba(201, 168, 76, 0.15);
    opacity: 0.7;
    transition: opacity 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .video-thumb:hover .thumb-frame {
    opacity: 1;
  }
  .video-thumb.is-active .thumb-frame {
    opacity: 1;
    border-color: rgba(201, 168, 76, 0.8);
    box-shadow: 0 0 12px rgba(201, 168, 76, 0.2);
  }
  .video-thumb.is-active .thumb-title {
    color: #C9A84C;
  }
  .thumb-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  const stage = document.getElementById('video-stage');
  const tituloEl = document.getElementById('video-titulo');
  const descEl = document.getElementById('video-desc');
  const playBtn = document.getElementById('video-play');

  // Sustituye el póster por el iframe de YouTube (solo se carga al reproducir)
  function loadPlayer(id: string, titulo: string) {
    if (!stage) return;
    const iframe = document.createElement('iframe');
    iframe.className = 'absolute inset-0 w-full h-full';
    iframe.src = `https://www.youtube.com/embed/${encodeURIComponent(id)}?autoplay=1`;
    iframe.title = titulo;
    iframe.style.border = '0';
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
    iframe.setAttribute('allowfullscreen', '');
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    stage.replaceChildren(iframe);
  }

  playBtn?.addEventListener('click', () => {
    const { id, titulo } = playBtn.dataset;
    if (id) loadPlayer(id, titulo ?? '');
  });

  document.querySelectorAll<HTMLButtonElement>('.video-thumb').forEach(btn => {
    btn.addEventListener('click', () => {
      const { id, titulo, descripcion } = btn.dataset;
      if (!id) return;
      document.querySelector('.video-thumb.is-active')?.classList.remove('is-active');
      btn.classList.add('is-active');
      if (tituloEl) tituloEl.textContent = titulo ?? '';
      if (descEl) descEl.textContent = descripcion ?? '';
      loadPlayer(id, titulo ?? '');
      stage?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
</script>
